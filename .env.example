# Copy to .env and replace CHANGE_ME values before running the services.
POSTGRES_DB=toir
POSTGRES_USER=toir
POSTGRES_PASSWORD=CHANGE_ME

# Use a unique random value of at least 32 bytes.
JWT_SECRET=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated frontend origins permitted by the backend.
# Replace with the exact HTTPS origin(s) that host the frontend in production.
CORS_ORIGINS=https://toir.example.com


# Public hostname used by Caddy and embedded into the production frontend build.
DOMAIN=toir.example.com

# Frontend API URL for local development. Compose uses https://${DOMAIN}/api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8010/api/v1

# Used by standalone PostgreSQL maintenance scripts when run in the backend container.
DATABASE_URL=postgresql://toir:CHANGE_ME@postgres:5432/toir

API_DOCS_ENABLED=false
