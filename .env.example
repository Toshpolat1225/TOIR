# Copy to .env and replace CHANGE_ME values before running the services.
POSTGRES_DB=toir
POSTGRES_USER=toir
POSTGRES_PASSWORD=CHANGE_ME

# Use a unique random value of at least 32 bytes.
JWT_SECRET=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated frontend origins permitted by the backend.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Keep empty until Wialon ingest is configured with a unique token.
WIALON_INGEST_TOKEN=

BACKEND_PORT=8000
API_DOCS_ENABLED=true
